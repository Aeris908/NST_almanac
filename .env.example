# Переменные окружения для сборки альманаха.
# Скопируйте в .env и подставьте свои значения (файл .env не попадает в git).

# Токен ВКонтакте для доступа к API сообщества (группа NEKKETSU SPORTS TOURNAMENTS).
# Используется в build_final_analytics.py при выгрузке данных.
# Без него сборка проходит, но имя группы подставляется по умолчанию.
VK_API_TOKEN=

# Сервер правки (`python db/serve.py`): без токена он не поднимается вовсе.
# Единственный редактор сообщества — один токен; в журнал правка попадает имя ниже.
NST_EDITOR_TOKEN=
NST_EDITOR_NAME=owner
# Откуда браузеру разрешено обращаться (через пробел или запятую). По умолчанию — локальный
# http://127.0.0.1:8000 и http://localhost:8000.
NST_EDITOR_ORIGINS=

# Адрес API редактора при сборке: на Vercel — точка (тот же источник), локально —
# http://127.0.0.1:8090 по умолчанию.
NST_EDITOR_API=

# Серверная база редактора Vercel и db/sync.py. Секрет, в git не добавлять.
NST_POSTGRES_URL=
# Необязательный явный путь SQLite для Vercel; приоритет выше NST_POSTGRES_URL.
NST_DB_PATH=
